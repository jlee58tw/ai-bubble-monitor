# ---- Backend ----
# SQLAlchemy URL. SQLite for MVP; Postgres later e.g. postgresql+psycopg://user:pass@db:5432/aibm
DATABASE_URL=sqlite:///./data/aibm.db
# REQUIRED by SEC fair-access policy: "<App name> <contact email>". Ingestion refuses to run without it.
SEC_USER_AGENT=
# SEC asks for <= 10 requests/second. Hard-capped at 10 in code.
SEC_MAX_RPS=5
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Scheduled refresh (APScheduler). Cron in UTC.
SCHEDULER_ENABLED=false
SCHEDULER_CRON=30 22 * * *
LOG_LEVEL=INFO
LOG_JSON=true
# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# ---- Phase 2 ----
# TWSE (Taiwan Stock Exchange) open data: months of daily price history per stock and request spacing
TWSE_HISTORY_MONTHS=13
TWSE_MIN_INTERVAL_S=3
# Optional free key from https://www.alphavantage.co/support/#api-key (US prices). Unset = UNAVAILABLE.
ALPHAVANTAGE_API_KEY=
# Recent 10-Q/10-K filings parsed for dimensional XBRL facts (NVDA Data Center revenue)
SEC_FILINGS_LIMIT=12
# Risk engine: minimum weighted data coverage before an overall score is shown precisely
# RISK_MIN_COVERAGE=0.5   # unset = use min_coverage from backend/app/registry/risk.yaml
# Weekly refresh of model pricing, benchmarks, GPU prices + risk snapshot (UTC cron; Sun 23:00 UTC = Mon 07:00 Taipei). Needs SCHEDULER_ENABLED=true
DATASETS_CRON=0 23 * * 0
