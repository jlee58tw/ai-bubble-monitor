# ---- Backend ----
# SQLAlchemy URL. SQLite for MVP; Postgres later e.g. postgresql+psycopg://user:pass@db:5432/aibm
DATABASE_URL=sqlite:///./data/aibm.db
# REQUIRED by SEC fair-access policy: "<App name> <contact email>". Ingestion refuses to run without it.
SEC_USER_AGENT=
# SEC asks for <= 10 requests/second. Hard-capped at 10 in code.
SEC_MAX_RPS=5
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Scheduled refresh (APScheduler). Cron in UTC.
SCHEDULER_ENABLED=false
SCHEDULER_CRON=30 22 * * *
LOG_LEVEL=INFO
LOG_JSON=true
# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
